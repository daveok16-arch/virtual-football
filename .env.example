# Copy this file to .env and fill in your values. NEVER commit the real .env.
#
# Telegram bot — create a bot with @BotFather to get the token, then get your
# chat id (e.g. message @userinfobot). For a channel, use @channelname or the
# channel id.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
TELEGRAM_CHAT_ID=123456789

# Bot loop tuning (optional)
RUN_INTERVAL_SECONDS=300
CAPTURE_SECONDS=90

# Puppeteer — on Render/Docker this is set to the system Chromium.
# Locally you can usually leave it unset (puppeteer uses its bundled Chromium).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
