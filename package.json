{
  "name": "sportybet-scheduled-virtuals-scraper",
  "version": "1.0.0",
  "description": "Puppeteer interceptor for SportyBet Scheduled Virtual Football via GoldenRace WebSocket CDP interception",
  "main": "intercept-scheduled-virtuals.js",
  "scripts": {
    "intercept": "node intercept-scheduled-virtuals.js",
    "start": "node bot-runner.js",
    "bot": "node bot-runner.js",
    "log": "node macro-logger.js",
    "macro": "node macro-logger.js",
    "predict": "node predict.js",
    "ev": "node predict.js ev",
    "edge": "node -e \"const {computeEdge,formatEdgeReport}=require('./edge-calculator'); computeEdge({window:0}).then(a=>console.log(formatEdgeReport(a).replace(/<[^>]+>/g,''))).catch(e=>console.error(e))\"",
    "backtest": "node predict.js backtest"
  },
  "dependencies": {
    "puppeteer": "^23.0.0"
  }
}
